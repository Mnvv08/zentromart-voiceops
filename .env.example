# Copy this file to .env and fill in your own keys. Never commit .env.

# --- LLM (any OpenAI-compatible API). Choose: groq | gemini | openai
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional overrides
# LLM_MODEL=openai/gpt-oss-120b   (alternative: qwen/qwen3.8-27b)
# LLM_BASE_URL=

# --- Gnani speech (STT + TTS). One key covers both. Get it at app.gnani.ai/voice
GNANI_API_KEY=

# --- Dataset location (folder that contains kb/, data/, tools/, practice/)
DATASET_DIR=./Capstone_Project_Dataset_FTTT_2026

# --- Optional voice settings
# STT_MODE=dual          # dual (en-IN + hi-IN) | en-IN | hi-IN | ta-IN ...
# TTS_MODEL=timbre-v2.5
# TTS_VOICE_EN=Kaveri
# TTS_VOICE_HI=Nalini
